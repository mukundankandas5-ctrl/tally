{
  "name": "tally-ai-connector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "electron-store": "^10.1.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yourname.tallyconnector",
    "productName": "Tally AI Connector",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
